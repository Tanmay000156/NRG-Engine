# ==============================================================================
# NRG ENGINE — LOCAL ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to `.env` (never commit `.env` to git) and set at least ONE
# real AI provider credential below to enable LLM autocomplete & AI Chat Studio.
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Judge0 Cloud Compiler Sandbox (optional — local toolchains run natively when present)
# JUDGE0_URL=https://ce.judge0.com
# RAPIDAPI_KEY=

# ------------------------------------------------------------------------------
# AI PROVIDERS (Configure any ONE or more below)
# ------------------------------------------------------------------------------

# 1. Google Gemini (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# NRG_GEMINI_MODEL=gemini-2.0-flash

# 2. OpenAI or OpenAI-Compatible Endpoint (OpenRouter, Together, vLLM, etc.)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# NRG_OPENAI_MODEL=gpt-4o-mini

# 3. Groq Cloud (https://console.groq.com/keys)
# GROQ_API_KEY=
# NRG_GROQ_MODEL=llama-3.3-70b-versatile

# 4. Anthropic Claude (https://console.anthropic.com/)
# ANTHROPIC_API_KEY=
# NRG_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# 5. Local Ollama Server (https://ollama.com — no API key required)
# OLLAMA_HOST=http://127.0.0.1:11434
# NRG_OLLAMA_MODEL=qwen2.5-coder:3b
